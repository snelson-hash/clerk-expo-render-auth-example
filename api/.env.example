# Copy to api/.env locally; never commit that file.
PORT=3000
CLERK_PUBLISHABLE_KEY=REPLACE_WITH_YOUR_DEVELOPMENT_PUBLISHABLE_KEY
CLERK_SECRET_KEY=REPLACE_WITH_YOUR_DEVELOPMENT_SECRET_KEY
CLERK_EXPECTED_ISSUER=https://YOUR_INSTANCE.clerk.accounts.dev
# Comma-separated exact authorized-party values. Do not list the API just
# because it receives requests: these are client origins/verified azp values.
CLERK_AUTHORIZED_PARTIES=https://YOUR_AUTHORIZED_CLIENT_ORIGIN.example
CLERK_PROXY_ENABLED=false
# Leave CLERK_JWT_KEY, CLERK_API_URL and CLERK_API_VERSION absent for baseline.
